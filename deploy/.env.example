# 正式域名只写主机名，由 Caddy 管理 HTTPS 证书。
INVITE_DOMAIN=invite.example.com

# 默认路径相对 deploy/。如需覆盖范围，请使用主机绝对路径。
# INVITE_MYSQL_CONFIG=/srv/invite-studio/private/connection.json
# INVITE_MYSQL_CA_DIR=/srv/invite-studio/private/mysql-ca

# 网段和 IP 必须对应，并与已有主机、VPC 及 Docker 网段避开冲突。
INVITE_PROXY_SUBNET=172.31.252.0/28
INVITE_PROXY_IP=172.31.252.2
